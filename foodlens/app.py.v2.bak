# =========================================================
# HERO
# =========================================================
st.markdown("""
<div class="hero">
    <h1>🍲 FoodLens</h1>
    <p>Snap a Nigerian dish — know what it is & how it affects your body.</p>
    <div class="badge">🤖 AI-powered · 92.9% accuracy · v1</div>
</div>
""", unsafe_allow_html=True)

# =========================================================
# MODEL LOADING
# =========================================================
@st.cache_resource
def load_model():
    device = torch.device("cpu")
    MODEL_PATH = Path(__file__).parent / "models" / "foodlens_v2.pt"
    ckpt = torch.load(MODEL_PATH, map_location=device, weights_only=False)
    model = models.mobilenet_v2(weights=None)
    model.classifier[1] = nn.Linear(model.last_channel, len(ckpt["classes"]))
    model.load_state_dict(ckpt["model_state"])
    model.eval()
    return model, ckpt["classes"], device

model, classes, device = load_model()

preprocess = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
])

# =========================================================
# HEALTH DATABASE
# =========================================================
HEALTH = {
    "jollof_rice": {
        "name": "Jollof Rice",
        "emoji": "🍚",
        "summary": "A one-pot rice dish cooked in tomato-pepper base with oil and spices. Nigeria's most iconic meal.",
        "warnings": [
            ("High in carbohydrates — can spike blood sugar quickly", "high"),
            ("Fried in oil — high in fat and calories", "medium"),
            ("Spicy — may irritate ulcers or sensitive stomachs", "medium"),
            ("Easy to overeat — large portions are common", "medium"),
        ],
        "avoid_if": ["Diabetic", "High blood pressure", "Ulcer or GERD"],
        "good_for": ["Active people who need energy", "Pre-training meals"],
    },
    "egusi_soup": {
        "name": "Egusi Soup",
        "emoji": "🥣",
        "summary": "A thick, rich soup made from ground melon seeds, leafy greens, palm oil, and meat or fish.",
        "warnings": [
            ("Very high in palm oil — cholesterol risk", "high"),
            ("Rich and heavy — slow to digest", "medium"),
            ("Contains melon seeds — possible allergy", "medium"),
            ("Usually paired with pounded yam — heavy meal", "medium"),
        ],
        "avoid_if": ["Heart issues", "Nut or seed allergy", "Acid reflux"],
        "good_for": ["Protein needs", "Cold weather meals"],
    },
}

# =========================================================
# INTRO CARDS (before upload)
# =========================================================
col1, col2, col3 = st.columns(3)
with col1:
    st.markdown("""
    <div class="card">
        <div class="emoji">📸</div>
        <h3>1. Upload a photo</h3>
        <p>Take a clear photo of your food. JPG, PNG, or WEBP.</p>
    </div>
    """, unsafe_allow_html=True)
with col2:
    st.markdown("""
    <div class="card">
        <div class="emoji">🧠</div>
        <h3>2. AI identifies it</h3>
        <p>A neural network trained on Nigerian dishes recognizes what's on your plate.</p>
    </div>
    """, unsafe_allow_html=True)
with col3:
    st.markdown("""
    <div class="card">
        <div class="emoji">⚠️</div>
        <h3>3. Know the risks</h3>
        <p>Learn what happens if you eat too much — and who should avoid it.</p>
    </div>
    """, unsafe_allow_html=True)

st.markdown("<br>", unsafe_allow_html=True)

# =========================================================
# SUPPORTED DISHES
# =========================================================
st.markdown("#### 🍽️ Currently supported")
st.markdown("""
<span class="chip">🍚 Jollof Rice</span>
<span class="chip">🥣 Egusi Soup</span>
<span class="chip" style="opacity:0.5;">🍌 Fried Plantain (coming soon)</span>
<span class="chip" style="opacity:0.5;">🍢 Suya (coming soon)</span>
<span class="chip" style="opacity:0.5;">🍥 Pounded Yam (coming soon)</span>
""", unsafe_allow_html=True)

st.markdown("<br>", unsafe_allow_html=True)

# =========================================================
# UPLOAD + PREDICT
# =========================================================
st.markdown("### 📸 Upload your food photo")

uploaded = st.file_uploader(
    "Choose a photo",
    type=["jpg", "jpeg", "png", "webp"],
    label_visibility="collapsed",
)

if uploaded:
    img = Image.open(uploaded).convert("RGB")
    col_img, col_res = st.columns([1, 1], gap="large")

    with col_img:
        st.image(img, caption="Your photo", use_container_width=True)

    with col_res:
        tensor = preprocess(img).unsqueeze(0).to(device)
        with torch.no_grad():
            out = model(tensor)
            probs = torch.softmax(out, dim=1)[0]
            idx = probs.argmax().item()
        pred_class = classes[idx]
        confidence = probs[idx].item()

        info = HEALTH.get(pred_class, {})

        st.markdown(f"""
        <div class="result-box">
            <h2 style="margin:0;">{info.get('emoji','🍽️')} {info.get('name', pred_class)}</h2>
            <p style="color:#666;margin:0.5rem 0 1rem 0;">{info.get('summary','')}</p>
        </div>
        """, unsafe_allow_html=True)

        st.markdown("<br>", unsafe_allow_html=True)
        st.markdown("**Confidence**")
        st.progress(confidence)
        st.caption(f"{confidence:.1%} confident")

        if confidence < 0.70:
            st.warning(
                "⚠️ Low confidence. Try a clearer, well-lit photo with the food centered."
            )

    # Health warnings below in two columns
    st.markdown("---")
    col_warn, col_avoid = st.columns(2, gap="large")

    with col_warn:
        st.markdown("### ⚠️ If you eat too much")
        for text, level in info.get("warnings", []):
            badge = {"high": "High", "medium": "Medium"}.get(level, "")
            badge_class = f"badge-{level}"
            st.markdown(
                f'<span class="{badge_class}">{badge}</span>&nbsp;&nbsp;{text}',
                unsafe_allow_html=True,
            )

    with col_avoid:
        st.markdown("### ❌ Avoid if you have")
        for a in info.get("avoid_if", []):
            st.markdown(f"❌ **{a}**")

        if info.get("good_for"):
            st.markdown("### ✅ Good for")
            for g in info.get("good_for", []):
                st.markdown(f"✅ {g}")

else:
    st.info("👆 **Upload a photo above to get started.**")

