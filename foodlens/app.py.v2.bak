st.divider()

col_f1, col_f2, col_f3 = st.columns(3)
with col_f1:
    st.caption("🧠 Model: MobileNetV2 · 92.9% val accuracy")
with col_f2:
    st.caption("📊 Trained on 80 images · 2 dishes")
with col_f3:
    st.caption("�� [GitHub Repo](https://github.com/sjohn500/project)")

st.caption(
    "⚠️ **Disclaimer:** FoodLens provides general health information, "
    "not medical advice. Consult a doctor for personal health decisions."
)
